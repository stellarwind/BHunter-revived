# Original game/media and local reverse-engineering database
/GAME_DATA/
/ghidra-projects/
*.mdf
*.mds
*.iso
*.bin
*.cab
*.zip
*.7z

# Build products, local compiler runtimes and caches
/build/
/dist/
*.exe
*.dll
*.obj
*.o
*.lib
*.pdb
*.ilk
*.exp
*.map
*.log
__pycache__/
*.py[cod]
.venv/
.env
.env.*

# Preserve curated research; exclude generated compiler experiments and dumps.
/analysis/*
!/analysis/README.md
!/analysis/RESEARCH.md
!/analysis/*.py
!/analysis/*.java
!/analysis/compiler_probes.c
!/analysis/assets-index.json
!/analysis/binary-map.json
!/analysis/call-edges.tsv
!/analysis/crt-comparison.json
!/analysis/crt-symbols.tsv
!/analysis/function-map.tsv
!/analysis/imports.json
!/analysis/subsystems.tsv
!/analysis/unassigned-code.tsv
!/analysis/math/
/analysis/math/*
!/analysis/math/RECOVERY.md
!/analysis/math/differential.c
!/analysis/math/differential-results.txt
!/analysis/math/build_and_test.ps1
!/analysis/math/compare_builds.py
!/analysis/astra-review/
/analysis/astra-review/*
!/analysis/astra-review/REVIEW.md
!/analysis/astra-review/FINDINGS.md
!/analysis/astra-review/FIXED_SETUP_FINDINGS.md
!/analysis/astra-review/matched_math.cpp
!/analysis/astra-review/matched_translation.cpp
!/analysis/astra-review/verify_fixed_math.py
!/analysis/astra-review/verify_translation.py
!/analysis/astra-review/targeted_probes.py
